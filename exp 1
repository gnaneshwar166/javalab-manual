import java.util.Scanner;

class Boarder {
    String name;
    int days;

    Boarder(String n, int d) {
        name = n;
        days = d;
    }

    double bill() {
        double amount = days * 85.0;

        // 10% rebate if days are less than 26
        if (days < 26) {
            amount = amount - (amount * 0.10);
        }

        return amount;
    }
}

public class MessBill {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Read number of students
        System.out.print("Enter number of students: ");
        int n = sc.nextInt();

        Boarder[] list = new Boarder[n];

        // Read student details
        for (int i = 0; i < n; i++) {
            System.out.print("Enter name: ");
            String name = sc.next();

            System.out.print("Enter number of days: ");
            int days = sc.nextInt();

            list[i] = new Boarder(name, days);
        }

        double total = 0;
        Boarder highest = list[0];

        System.out.println("\nNAME       DAYS     BILL");
        System.out.println("-------------------------");

        for (Boarder b : list) {

            double amount = b.bill();

            System.out.printf("%-10s %4d %8.2f%n",
                    b.name, b.days, amount);

            total = total + amount;

            // Find highest bill
            if (b.bill() > highest.bill()) {
                highest = b;
            }
        }

        System.out.println("-------------------------");
        System.out.printf("Total collection = Rs. %.2f%n", total);

        System.out.println("Highest bill student = "
                + highest.name);

        System.out.printf("Highest bill = Rs. %.2f%n",
                highest.bill());

        sc.close();
    }
}
